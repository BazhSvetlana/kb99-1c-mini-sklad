# --- Системные и временные файлы ОС ---
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
*~

# --- Файлы 1С (не храним в Git) ---
# Выгрузки конфигурации и базы — это бинарные файлы, их не коммитят
*.cf
*.cfe
*.dt

# Временные файлы Конфигуратора и платформы
1Cv8.lgd
1Cv8Tmp.1cd
1cv8conn.pfl

# --- Папки кэша, сборки, временных данных ---
bin/
obj/
tmp/
temp/
cache/
.cache/

# --- Настройки IDE и редакторов (чтобы не тащить личные конфиги) ---
.idea/
.vscode/
*.swp
*.swo

# --- Секреты, ключи, персональные настройки ---
config.env
*.key
*.pfx
*.cert
password.txt
secret.txt

# --- Логи и отчёты ---
*.log
logs/
report.log

# --- Пакеты и зависимости (если есть сторонние компоненты) ---
node_modules/
vendor/
packages/
