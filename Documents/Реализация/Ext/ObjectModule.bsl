

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.Остатки.Записывать = Истина;
	Движения.Стоимость.Записывать = Истина; 
	Движения.Продажи.Записывать = Истина;
	
	// Создать менеджер временных таблиц
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	#Область НоменклатураДокумента
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РеализацияПереченьНоменклатуры.Номенклатура КАК Номенклатура,
			|	РеализацияПереченьНоменклатуры.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
			|	СУММА(РеализацияПереченьНоменклатуры.Количество) КАК КоличествоВДокументе,
			|	СУММА(РеализацияПереченьНоменклатуры.Сумма) КАК СуммаВДокументе
			|ПОМЕСТИТЬ НоменклатураДокумента
			|ИЗ
			|	Документ.Реализация.ПереченьНоменклатуры КАК РеализацияПереченьНоменклатуры
			|ГДЕ
			|	РеализацияПереченьНоменклатуры.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	РеализацияПереченьНоменклатуры.Номенклатура,
			|	РеализацияПереченьНоменклатуры.Номенклатура.ВидНоменклатуры";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
	#КонецОбласти
	
	
