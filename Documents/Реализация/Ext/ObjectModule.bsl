
Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ПартииМатериалов.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.Обороты.Записывать = Истина;

	// 1. Итоги по номенклатуре документа — во временную таблицу
	МенеджерВТ = Новый МенеджерВременныхТаблиц;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПереченьНоменклатуры.Номенклатура КАК Номенклатура,
		|	ПереченьНоменклатуры.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
		|	СУММА(ПереченьНоменклатуры.Количество) КАК КоличествоВДокументе,
		|	СУММА(ПереченьНоменклатуры.Сумма) КАК СуммаВДокументе
		|ПОМЕСТИТЬ НоменклатураДокумента
		|ИЗ
		|	Документ.Реализация.ПереченьНоменклатуры КАК ПереченьНоменклатуры
		|ГДЕ
		|	ПереченьНоменклатуры.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПереченьНоменклатуры.Номенклатура,
		|	ПереченьНоменклатуры.Номенклатура.ВидНоменклатуры";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Выполнить();

	// 2. Блокировка и запись пустого набора — остатки читаются без учёта документа
	Движения.ПартииМатериалов.БлокироватьДляИзменения = Истина;
	Движения.ПартииМатериалов.Записать();

	// 3. Остатки партий на момент документа, от ранних к поздним — это и есть ФИФО
	ЗапросПартий = Новый Запрос;
	ЗапросПартий.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПартий.Текст =
		"ВЫБРАТЬ
		|	ОстаткиПартий.Товар КАК Товар,
		|	ОстаткиПартий.Партия КАК Партия,
		|	ОстаткиПартий.КоличествоОстаток КАК Количество,
		|	ОстаткиПартий.СтоимостьОстаток КАК Стоимость
		|ИЗ
		|	РегистрНакопления.ПартииМатериалов.Остатки(
		|			&ГраницаМомент,
		|			Товар В (ВЫБРАТЬ Номенклатура ИЗ НоменклатураДокумента)) КАК ОстаткиПартий
		|УПОРЯДОЧИТЬ ПО
		|	ОстаткиПартий.Партия.Дата";

	ЗапросПартий.УстановитьПараметр("ГраницаМомент",
		Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	ВыборкаПартий = ЗапросПартий.Выполнить().Выбрать();

	// 4. Движения по позициям документа
	ЗапросИтогов = Новый Запрос;
	ЗапросИтогов.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросИтогов.Текст =
		"ВЫБРАТЬ
		|	НоменклатураДокумента.Номенклатура КАК Номенклатура,
		|	НоменклатураДокумента.ВидНоменклатуры КАК ВидНоменклатуры,
		|	НоменклатураДокумента.КоличествоВДокументе КАК КоличествоВДокументе,
		|	НоменклатураДокумента.СуммаВДокументе КАК СуммаВДокументе
		|ИЗ
		|	НоменклатураДокумента КАК НоменклатураДокумента
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";

	ВыборкаДокумента = ЗапросИтогов.Выполнить().Выбрать();

	Пока ВыборкаДокумента.Следующий() Цикл

		СтоимостьСписания = 0;

		Если ВыборкаДокумента.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Материал Тогда

			НужноСписать = ВыборкаДокумента.КоличествоВДокументе;
			ЕстьВНаличии = 0;

			ВыборкаПартий.Сбросить();
			Пока ВыборкаПартий.Следующий() Цикл

				Если ВыборкаПартий.Товар <> ВыборкаДокумента.Номенклатура Тогда
					Продолжить;
				КонецЕсли;
				Если НужноСписать <= 0 Тогда
					Прервать;
				КонецЕсли;

				СписатьПартии = Мин(ВыборкаПартий.Количество, НужноСписать);

				// Пропорционально; при полном списании партии — весь остаток стоимости
				Если СписатьПартии = ВыборкаПартий.Количество Тогда
					СтоимостьСписанияПартии = ВыборкаПартий.Стоимость;
				Иначе
					СтоимостьСписанияПартии = ВыборкаПартий.Стоимость
						/ ВыборкаПартий.Количество * СписатьПартии;
				КонецЕсли;

				// Расход по регистру партий
				Движение = Движения.ПартииМатериалов.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период      = Дата;
				Движение.Товар       = ВыборкаПартий.Товар;
				Движение.Партия      = ВыборкаПартий.Партия;
				Движение.Количество  = СписатьПартии;
				Движение.Стоимость   = СтоимостьСписанияПартии;

				СтоимостьСписания = СтоимостьСписания + СтоимостьСписанияПартии;
				ЕстьВНаличии = ЕстьВНаличии + ВыборкаПартий.Количество;
				НужноСписать = НужноСписать - СписатьПартии;

			КонецЦикла;

			Если НужноСписать > 0 Тогда
				Отказ = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Товар """ + Строка(ВыборкаДокумента.Номенклатура)
					+ """: требуется " + Строка(ВыборкаДокумента.КоличествоВДокументе)
					+ ", есть " + Строка(ЕстьВНаличии)
					+ ", не хватает " + Строка(НужноСписать);
				Сообщение.Сообщить();
			КонецЕсли;

		КонецЕсли;

		// Регистр Продажи — себестоимость из списанных партий
		Движение = Движения.Продажи.Добавить();
		Движение.Период       = Дата;
		Движение.Номенклатура = ВыборкаДокумента.Номенклатура;
		Движение.Клиент       = Клиенты;
		Движение.Мастер       = Мастер;
		Движение.Количество   = ВыборкаДокумента.КоличествоВДокументе;
		Движение.Выручка      = ВыборкаДокумента.СуммаВДокументе;
		Движение.Стоимость    = СтоимостьСписания;

	КонецЦикла;

	// 5. Регистр Обороты — как был, приход по строкам ТЧ
	Для Каждого ТекСтрокаПереченьНоменклатуры Из ПереченьНоменклатуры Цикл
		Движение = Движения.Обороты.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;
		Движение.Товары      = ТекСтрокаПереченьНоменклатуры.Номенклатура;
		Движение.Склад       = Склад;
		Движение.Клиент      = Клиенты;
		Движение.СуммаОборот = ТекСтрокаПереченьНоменклатуры.Сумма;
	КонецЦикла;

	Движения.Записать();

КонецПроцедуры
