

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.Остатки.Записывать = Истина;
	Движения.Стоимость.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.Обороты.Записывать = Истина;

	// 1. Итоги по номенклатуре документа — во временную таблицу
	МенеджерВТ = Новый МенеджерВременныхТаблиц;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПереченьНоменклатуры.Номенклатура КАК Номенклатура,
		|	ПереченьНоменклатуры.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
		|	СУММА(ПереченьНоменклатуры.Количество) КАК КоличествоВДокументе,
		|	СУММА(ПереченьНоменклатуры.Сумма) КАК СуммаВДокументе
		|ПОМЕСТИТЬ НоменклатураДокумента
		|ИЗ
		|	Документ.Реализация.ПереченьНоменклатуры КАК ПереченьНоменклатуры
		|ГДЕ
		|	ПереченьНоменклатуры.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПереченьНоменклатуры.Номенклатура,
		|	ПереченьНоменклатуры.Номенклатура.ВидНоменклатуры";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Выполнить();

	// 2. Блокировка и запись пустых наборов — чтобы остатки читались без учёта самого документа
	Движения.Остатки.БлокироватьДляИзменения = Истина;
	Движения.Стоимость.БлокироватьДляИзменения = Истина;
	Движения.Остатки.Записать();
	Движения.Стоимость.Записать();

	// 3. Остатки по партиям на момент документа.
	//    ФИФО: сортируем по дате партии — первой списывается самая ранняя.
	ЗапросПартий = Новый Запрос;
	ЗапросПартий.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПартий.Текст =
		"ВЫБРАТЬ
		|	ОстаткиПартий.Материалы КАК Материал,
		|	ОстаткиПартий.Партия КАК Партия,
		|	ОстаткиПартий.КоличествоОстаток КАК Количество,
		|	ОстаткиПартий.СебестоимостьОстаток КАК Себестоимость
		|ИЗ
		|	РегистрНакопления.Остатки.Остатки(
		|			&ГраницаМомент,
		|			Материалы В (ВЫБРАТЬ Номенклатура ИЗ НоменклатураДокумента)
		|			И Склад = &Склад) КАК ОстаткиПартий
		|УПОРЯДОЧИТЬ ПО
		|	ОстаткиПартий.Партия.Дата";

	ЗапросПартий.УстановитьПараметр("ГраницаМомент",
		Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	ЗапросПартий.УстановитьПараметр("Склад", Склад);

	ВыборкаПартий = ЗапросПартий.Выполнить().Выбрать();

	// 4. Движения по позициям документа
	ЗапросИтогов = Новый Запрос;
	ЗапросИтогов.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросИтогов.Текст =
		"ВЫБРАТЬ
		|	НоменклатураДокумента.Номенклатура КАК Номенклатура,
		|	НоменклатураДокумента.ВидНоменклатуры КАК ВидНоменклатуры,
		|	НоменклатураДокумента.КоличествоВДокументе КАК КоличествоВДокументе,
		|	НоменклатураДокумента.СуммаВДокументе КАК СуммаВДокументе
		|ИЗ
		|	НоменклатураДокумента КАК НоменклатураДокумента
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";

	ВыборкаДокумента = ЗапросИтогов.Выполнить().Выбрать();

	Пока ВыборкаДокумента.Следующий() Цикл

		СтоимостьСписания = 0;

		Если ВыборкаДокумента.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Материал Тогда

			НужноСписать = ВыборкаДокумента.КоличествоВДокументе;

			ВыборкаПартий.Сбросить();
			Пока ВыборкаПартий.Следующий() Цикл

				Если ВыборкаПартий.Материал <> ВыборкаДокумента.Номенклатура Тогда
					Продолжить; // чужие материалы пропускаем
				КонецЕсли;
				Если НужноСписать <= 0 Тогда
					Прервать; // набрали нужное количество
				КонецЕсли;

				СписатьПартии = Мин(ВыборкаПартий.Количество, НужноСписать);
				СтоимостьПартии = ?(ВыборкаПартий.Количество = 0, 0,
					ВыборкаПартий.Себестоимость / ВыборкаПартий.Количество * СписатьПартии);

				// Регистр Остатки — расход по конкретной партии
				Движение = Движения.Остатки.Добавить();
				Движение.ВидДвижения   = ВидДвиженияНакопления.Расход;
				Движение.Период        = Дата;
				Движение.Склад         = Склад;
				Движение.Материалы     = ВыборкаПартий.Материал;
				Движение.Партия        = ВыборкаПартий.Партия;
				Движение.Количество    = СписатьПартии;
				Движение.Себестоимость = СтоимостьПартии;

				// Регистр Стоимость — расход себестоимости
				Движение = Движения.Стоимость.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период      = Дата;
				Движение.Материал    = ВыборкаПартий.Материал;
				Движение.Стоимость   = СтоимостьПартии;

				СтоимостьСписания = СтоимостьСписания + СтоимостьПартии;
				НужноСписать = НужноСписать - СписатьПартии;

			КонецЦикла;

			Если НужноСписать > 0 Тогда
				Отказ = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не хватает " + Строка(НужноСписать)
					+ " единиц материала """ + Строка(ВыборкаДокумента.Номенклатура) + """";
				Сообщение.Сообщить();
			КонецЕсли;

		КонецЕсли;

		// Регистр Продажи — по всей номенклатуре (у услуг себестоимость 0)
		Движение = Движения.Продажи.Добавить();
		Движение.Период      = Дата;
		Движение.Номенклатура = ВыборкаДокумента.Номенклатура;
		Движение.Клиент      = Клиенты;
		Движение.Мастер      = Мастер;
		Движение.Количество  = ВыборкаДокумента.КоличествоВДокументе;
		Движение.Выручка     = ВыборкаДокумента.СуммаВДокументе;
		Движение.Стоимость   = СтоимостьСписания;

	КонецЦикла;

	// 5. Регистр Обороты
	Для Каждого ТекСтрокаПереченьНоменклатуры Из ПереченьНоменклатуры Цикл
		Движение = Движения.Обороты.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;
		Движение.Товары      = ТекСтрокаПереченьНоменклатуры.Номенклатура;
		Движение.Склад       = Склад;
		Движение.Клиент      = Клиенты;
		Движение.СуммаОборот = ТекСтрокаПереченьНоменклатуры.Сумма;
	КонецЦикла;

	Движения.Записать();

	// 6. Контроль отрицательных остатков при оперативном проведении
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		ЗапросКонтроля = Новый Запрос;
		ЗапросКонтроля.МенеджерВременныхТаблиц = МенеджерВТ;
		ЗапросКонтроля.Текст =
			"ВЫБРАТЬ
			|	ОстаткиПартий.Материалы КАК Материал,
			|	ОстаткиПартий.КоличествоОстаток КАК КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.Остатки.Остатки(,
			|			Материалы В (ВЫБРАТЬ Номенклатура ИЗ НоменклатураДокумента)
			|			И Склад = &Склад) КАК ОстаткиПартий
			|ГДЕ
			|	ОстаткиПартий.КоличествоОстаток < 0";

		ЗапросКонтроля.УстановитьПараметр("Склад", Склад);
		ВыборкаКонтроля = ЗапросКонтроля.Выполнить().Выбрать();

		Пока ВыборкаКонтроля.Следующий() Цикл
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает " + Строка(-ВыборкаКонтроля.КоличествоОстаток)
				+ " единиц материала """ + Строка(ВыборкаКонтроля.Материал) + """";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
