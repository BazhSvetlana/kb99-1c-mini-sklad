					//
					//  КонецЦикла;
					//
					
	
	
	
	
	 		// регистр Обороты Приход
			Движения.Обороты.Записывать = Истина;
			Для Каждого ТекСтрокаПереченьНоменклатуры Из ПереченьНоменклатуры Цикл
				Движение = Движения.Обороты.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.Период = Дата;
				Движение.Товары = ТекСтрокаПереченьНоменклатуры.Номенклатура;
				Движение.Склад = Склад;
				Движение.Клиент = Клиенты;
				Движение.СуммаОборот = ТекСтрокаПереченьНоменклатуры.Сумма;
			КонецЦикла;
			Движения.Записать();     
			
			#КонецОбласти
	
	
	
	
	#Область КонтрольОстатков
				Если Режим = РежимПроведенияДокумента.Оперативный Тогда
				// Проверить отрицательные остатки
				Запрос3 = Новый Запрос;
				Запрос3.МенеджерВременныхТаблиц = МенеджерВТ;
				Запрос3.Текст = "
						|ВЫБРАТЬ
						| ОстаткиОстатки.Материалы КАК Материал,
						| ОстаткиОстатки.КоличествоОстаток КАК КоличествоОстаток
						|ИЗ
						| РегистрНакопления.Остатки.Остатки( , Материалы В (
						| ВЫБРАТЬ
						| НоменклатураДокумента.Номенклатура
