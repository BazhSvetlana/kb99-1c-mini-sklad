
Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Остатки.Записывать = Истина;
	Движения.Стоимость.Записывать = Истина;

	// Регистр Остатки — приход с привязкой к партии
	Для Каждого ТекСтрокаМатериалы Из Материалы Цикл
		Движение = Движения.Остатки.Добавить();
		Движение.ВидДвижения   = ВидДвиженияНакопления.Приход;
		Движение.Период        = Дата;

		Движение.Склад         = Склад;
		Движение.Материалы     = ТекСтрокаМатериалы.Материал;
		// Партия — сам проводимый документ
		Движение.Партия        = Ссылка;

		Движение.Количество    = ТекСтрокаМатериалы.Количество;
		Движение.Себестоимость = ТекСтрокаМатериалы.Сумма;
	КонецЦикла;

	// Регистр Стоимость — приход стоимости
	Для Каждого ТекСтрокаМатериалы Из Материалы Цикл
		Движение = Движения.Стоимость.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;

		Движение.Материал  = ТекСтрокаМатериалы.Материал;
		Движение.Стоимость = ТекСтрокаМатериалы.Сумма;
	КонецЦикла;
КонецПроцедуры

