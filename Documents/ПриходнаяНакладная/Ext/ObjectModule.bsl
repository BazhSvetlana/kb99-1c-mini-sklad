Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ПартииМатериалов.Записывать = Истина;

	Для Каждого ТекСтрока Из Материалы Цикл
		Движение = Движения.ПартииМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;

		Движение.Товар      = ТекСтрока.Материал;
		Движение.Партия     = Ссылка; // партия — проводимый документ

		Движение.Количество = ТекСтрока.Количество;
		Движение.Стоимость  = ТекСтрока.Сумма;
	КонецЦикла;

КонецПроцедуры